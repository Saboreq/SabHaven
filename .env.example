# Safe browser values. Never put a Supabase secret/service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Upload limit for admin and user accounts. The owner role bypasses this app-level cap
# and is limited by the Supabase project's global Storage file-size setting instead.
VITE_MAX_UPLOAD_BYTES=52428800
