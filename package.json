{
  "name": "sabhaven",
  "version": "1.2.0",
  "description": "Invite-only file delivery with public downloads, private member storage, and server-enforced access controls.",
  "private": true,
  "type": "module",
  "author": "Saboreq",
  "homepage": "https://files.saboreq.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Saboreq/SabHaven.git"
  },
  "bugs": {
    "url": "https://github.com/Saboreq/SabHaven/issues"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "check": "npm run lint && npm test && npm run build",
    "lint": "eslint src tests api vite.config.js eslint.config.js --max-warnings 0",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  },
  "license": "MIT"
}
